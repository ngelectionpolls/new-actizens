# Copy to .env.local and fill in. Never commit real keys.
# Paystack
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Flutterwave
FLUTTERWAVE_SECRET_KEY=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

# Public URL used for payment return links (no trailing slash). Set it in production;
# when unset, the address the visitor is using is detected automatically.
# SITE_URL=https://your-domain.org
